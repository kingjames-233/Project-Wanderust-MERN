<% layout("/layouts/boilerplate") %>

<style>
    .hero {
        height: 70vh;
        background: url("https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=1600&q=80") center/cover no-repeat;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: white;
        position: relative;
        overflow: hidden;
    }

    .hero::after {
        content: "";
        position: absolute;
        top: 0; left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.45);
    }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 700px;
    }

    .hero h1 {
        font-size: 3rem;
        font-weight: bold;
    }

    .hero p {
        font-size: 1.2rem;
    }

    .feature-card {
        transition: transform 0.2s ease;
    }

    .feature-card:hover {
        transform: translateY(-5px);
    }

    .section-title {
        font-weight: 600;
        margin: 2rem 0 1rem;
    }
</style>

<!-- HERO SECTION -->
<div class="container mt-4">

    <div class="hero">
        <div class="hero-content">
            <h1>Find your perfect stay</h1>
            <p>Discover unique homes, cabins, and apartments around the world</p>

            <a href="/listings" class="btn btn-light btn-lg mt-3">
                Explore Listings
            </a>
        </div>
    </div>

    <!-- FEATURES -->
    <h3 class="section-title">Why choose us?</h3>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card feature-card shadow-sm p-3 text-center">
                <i class="fa-solid fa-house fs-1 text-primary"></i>
                <h5 class="mt-2">Unique Homes</h5>
                <p>Stay in carefully selected properties worldwide.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card feature-card shadow-sm p-3 text-center">
                <i class="fa-solid fa-shield-halved fs-1 text-success"></i>
                <h5 class="mt-2">Safe Booking</h5>
                <p>Secure payments and trusted hosts.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card feature-card shadow-sm p-3 text-center">
                <i class="fa-solid fa-star fs-1 text-warning"></i>
                <h5 class="mt-2">Top Rated</h5>
                <p>Highly rated stays with real reviews.</p>
            </div>
        </div>

    </div>

    <!-- CTA SECTION -->
    <div class="text-center mt-5 p-5 bg-light rounded">
        <h2>Ready to start your journey?</h2>
        <p>Browse thousands of listings and book your next stay today.</p>
        <a href="/listings" class="btn btn-dark btn-lg mt-2">Get Started</a>
    </div>

</div>
